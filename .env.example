# ==== Приложение ====
NODE_ENV=development
PORT=3000
# В production сървърът сервира и API-то, и фронтенда на един и същ адрес —
# тогава APP_BASE_URL и WEB_BASE_URL трябва да са еднакви.
APP_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173

# ==== База данни (MySQL) ====
DATABASE_URL=mysql://bileti:changeme@localhost:3306/bileti
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=bileti
MYSQL_PASSWORD=changeme

# ==== Сесии / Автентикация ====
SESSION_SECRET=
# Генерирайте с: openssl rand -hex 32

# ==== Stripe (НЕ Е ЗАДЪЛЖИТЕЛНО в момента) ====
# Плащанията в момента са фиктивни/вътрешни (checkout маркира поръчката
# платена веднага, без реален бизнес акаунт) — виж бележката в
# apps/server/src/modules/orders/orders.service.ts. Тези променливи остават
# тук единствено за да може по-късно, при наличие на реален Stripe акаунт,
# да се превключи към истинско плащане без промяна на архитектурата.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ==== Resend (email) ====
RESEND_API_KEY=
RESEND_FROM_EMAIL="Билети <tickets@yourdomain.com>"

# ==== Съхранение на PDF билетите ====
# R2_ENABLED=false (или липсващо) -> билетите се пазят локално на диск
#   (apps/server/storage/tickets/). Нулева настройка, работи веднага.
# R2_ENABLED=true -> билетите се качват в Cloudflare R2 (изисква попълнени
#   R2_* стойности по-долу).
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ==== Queue / Waiting room ====
QUEUE_ACTIVE_CHECKOUT_THRESHOLD=50

# ==== Reservation ====
RESERVATION_TTL_MINUTES=10
